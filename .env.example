# .env.example — copy to .env and fill in. NEVER commit real secrets.
# These are read by the server only; nothing here is sent to the browser.

# Required. Free at https://www.themoviedb.org/settings/api
# Use the long "API Read Access Token" (starts with eyJ) or the shorter API Key.
TMDB_API_KEY=

# Optional (defaults shown)
# PORT=8080
# DATA_DIR=./data        # where the SQLite file (profiles, My List) is kept
# REGION=US              # country for "where to watch" and age ratings (ISO code)
# LANGUAGE=en-US

# Roku app: only needed on the computer you build it from. See docs/ROKU-GUIDE.md.
# The Pi's address as the TV reaches it:
# ROKU_API_BASE=http://192.168.1.50:8080
# The Roku TV's IP address:
# ROKU_HOST=192.168.1.60
# The developer-mode password you set on the TV:
# ROKU_DEV_PASSWORD=
